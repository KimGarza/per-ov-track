{
  "cli": {
    "appVersionSource": "remote",
    "version": ">= 25.1.1"
  },
  "build": {
    "base": {
      "node": "22.23.3"
    },
    "development-all": {
      "extends": "base",
      "environment": "development",
      "android": {
        "developmentClient": true,
        "distribution": "internal",
        "buildType": "apk"
      },
      "ios": {
        "developmentClient": false,
        "distribution": "store",
        "simulator": false,
        "autoIncrement": true
      }
    },
    "development": {
      "extends": "development-all"
    },
    "production": {
      "extends": "base",
      "environment": "production",
      "distribution": "store",
      "developmentClient": false,
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "simulator": false
      }
    },
    "store-development": {
      "extends": "base",
      "environment": "development",
      "distribution": "store",
      "developmentClient": false,
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "simulator": false
      }
    },
    "store-staging": {
      "extends": "store-development",
      "environment": "preview"
    }
  },
  "submit": {
    "development-all": {
      "ios": {}
    },
    "production": {
      "ios": {},
      "android": {
        "track": "production",
        "releaseStatus": "draft"
      }
    },
    "store-development": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      },
      "ios": {}
    },
    "store-staging": {
      "extends": "store-development"
    }
  }
}
